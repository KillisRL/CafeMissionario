<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CafeMissionario.Views.LoginView"
             BackgroundColor="#7B2332">
    <ScrollView>
        <VerticalStackLayout Spacing="25" Padding="30,60,30,30" VerticalOptions="Center">

            <!-- Nome do Usuário -->
            <Border StrokeThickness="2"
                    Stroke="#E0E0E0"
                    StrokeShape="RoundRectangle 10" 
                    Padding="15,2">


                <Entry Text="{Binding Nome}"
                       Placeholder="Nome de Usuário"
                       TextColor="#E0E0E0"
                       BackgroundColor="Transparent"
                       HeightRequest="50"
                       Keyboard="Text"/>
            </Border>

            <!-- Senha do Usuário -->

            <Border Stroke="#E0E0E0"
                    StrokeThickness="2" 
                    StrokeShape="RoundRectangle 10" 
                    Padding="15,2">

                <Entry Text="{Binding Senha}"
                       TextColor="#E0E0E0"
                       Placeholder="Sua Senha"
                       BackgroundColor="Transparent"
                       IsPassword="True"
                       HeightRequest="50"
                       Keyboard="Text"/>
            </Border>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="20">

                <!-- Botão Voltar -->
                <Button Text="Voltar"
                        BorderColor="#E0E0E0"
                        CornerRadius="10"
                        BorderWidth="5"
                        Margin="0,10,0,0"
                        Grid.Column="0"
                        Command="{Binding AbrirTelaCommand}"
                        CommandParameter="//SplashScreen"
                        BackgroundColor="#7B2332"
                        TextColor="#E0E0E0"
                        FontAttributes="Bold"
                        FontSize="16"
                        HeightRequest="55" />

                <!-- Botão de Entrar -->
                <Button Command="{Binding LoginCommand}"
                        Grid.Column="1"
                        Text="ENTRAR"
                        BackgroundColor="#E0E0E0" 
                        TextColor="#7B2332"
                        FontAttributes="Bold"
                        HeightRequest="55"
                        CornerRadius="10"
                        Margin="0,10,0,0"/>
            </Grid>

            <!-- Link para Cadastro -->
            <Label HorizontalOptions="Center" Margin="0,10,0,0">
                <Label.FormattedText>
                    <FormattedString>
                        <Span Text="Não possui uma conta? "
                              TextColor="#E0E0E0"/>
                        <Span Text="Cadastre-se"
                              TextColor="#E0E0E0"
                              FontAttributes="Bold"
                              TextDecorations="Underline"/>
                    </FormattedString>
                </Label.FormattedText>
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding AbrirTelaCommand}"
                                          CommandParameter="UsuarioCadView"/>
                </Label.GestureRecognizers>
            </Label>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>