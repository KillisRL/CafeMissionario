<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CafeMissionario.Views.VendasDiaView"
             BackgroundColor="#7B2332">
    <!-- BOTÃO DE EXPORTAR NA BARRA SUPERIOR -->
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="Exportar" 
                     Command="{Binding ExportarRelatorioCommand}" />
    </ContentPage.ToolbarItems>
    <ScrollView>
        <VerticalStackLayout Spacing="15" 
                             Padding="20" 
                             MaximumWidthRequest="500">

            <!-- Card Resumo Financeiro -->
            <Border StrokeShape="RoundRectangle 12" 
                    BackgroundColor="#7B2332"
                    StrokeThickness="0" 
                    Padding="15">
                <Grid ColumnDefinitions="*, Auto">

                    <VerticalStackLayout Grid.Column="0">

                        <Label Text="Total Vendido Hoje"
                               TextColor="#E0E0E0"
                               FontAttributes="Bold"
                               FontSize="12"/>

                        <Label Text="{Binding TotalAcumuladoHoje, StringFormat='R$ {0:F2}'}" 
                               TextColor="#E0E0E0"
                               FontAttributes="Bold"
                               FontSize="22"/>

                    </VerticalStackLayout>

                    <Label Grid.Column="1"
                           Text="{Binding VendasHoje.Count, StringFormat='{0} vendas'}" 
                           TextColor="#E0E0E0"
                           VerticalOptions="Center"
                           FontSize="14"/>
                </Grid>
            </Border>

            <!-- Card Resumo de Produtos Vendidos -->
            <Border StrokeShape="RoundRectangle 12" 
                    BackgroundColor="#E0E0E0" 
                    StrokeThickness="0" 
                    Padding="15">

                <VerticalStackLayout Spacing="12">

                    <Label Text="Produtos Vendidos Hoje" 
                           FontAttributes="Bold" 
                           TextColor="#1C1C1E" 
                           FontSize="16"/>

                    <!-- Lista Agrupada -->
                    <VerticalStackLayout BindableLayout.ItemsSource="{Binding ResumoProdutos}" 
                                         Spacing="8">
                        <BindableLayout.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*, Auto">

                                    <Label Grid.Column="0" 
                                           Text="{Binding NomeProduto}" 
                                           TextColor="#1C1C1E" 
                                           FontSize="14" 
                                           VerticalOptions="Center"/>

                                    <Label Grid.Column="1" 
                                           Text="{Binding Quantidade, StringFormat='{0} un'}" 
                                           FontAttributes="Bold" 
                                           TextColor="#7B2332" 
                                           FontSize="14" 
                                           VerticalOptions="Center"/>

                                </Grid>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>
                    </VerticalStackLayout>

                    <!-- Linha Divisória -->
                    <BoxView HeightRequest="1" 
                             Color="#C7C7CC" 
                             Margin="0,5"/>

                    <!-- Total de Itens -->
                    <Grid ColumnDefinitions="*, Auto">

                        <Label Grid.Column="0" 
                               Text="Total de Itens" 
                               FontAttributes="Bold" 
                               TextColor="#6E6E73"/>

                        <Label Grid.Column="1" 
                               Text="{Binding TotalItensVendidos, StringFormat='{0} un'}" 
                               FontAttributes="Bold" 
                               TextColor="#1C1C1E"/>

                    </Grid>

                </VerticalStackLayout>
            </Border>

            <!-- Lista de Vendas Detalhada -->
            <CollectionView ItemsSource="{Binding VendasHoje}">
                <CollectionView.ItemTemplate>
                    <DataTemplate>

                        <Border StrokeShape="RoundRectangle 10"
                                BackgroundColor="#E0E0E0"
                                Padding="12"
                                Margin="0,0,0,10">

                            <Grid ColumnDefinitions="*, Auto"
                                  RowDefinitions="Auto, Auto, Auto"
                                  RowSpacing="4">

                                <HorizontalStackLayout Grid.Column="0"
                                                       Grid.Row="0"
                                                       Spacing="5">

                                    <Label Text="{Binding Cliente}"
                                           FontAttributes="Bold"
                                           TextColor="#1C1C1E"/>

                                    <Label Text="{Binding Total, StringFormat='R$ {0:F2}'}" 
                                       FontAttributes="Bold"
                                       TextColor="#7B2332"/>

                                </HorizontalStackLayout>

                                <Label Text="{Binding HoraFormatada, StringFormat='({0})'}"
                                       Grid.Row="1"
                                           TextColor="#8E8E93"
                                           FontSize="12"
                                           VerticalOptions="Center"/>

                                <HorizontalStackLayout Grid.Column="0"
                                                       Grid.Row="2"
                                                       Spacing="8">

                                    <Label Text="{Binding Vendedor, StringFormat='Vendedor: {0}'}"
                                           TextColor="#6E6E73"
                                           FontSize="12"/>

                                    <Label Text="•"
                                           TextColor="#E0E0E0"
                                           FontSize="12"/>

                                    <Label Text="{Binding FormaPagamento}"
                                           TextColor="#6E6E73"
                                           FontSize="12"/>

                                </HorizontalStackLayout>
                                <!-- Lado Direito: Botão de Apagar -->
                                <HorizontalStackLayout Grid.Column="1"
                                                       Grid.RowSpan="3"
                                                       VerticalOptions="Center">
                                    <ImageButton Source="lixeirarecompensa.png" 
                                             HeightRequest="30" 
                                             WidthRequest="30"
                                             Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                                Path=BindingContext.CancelarVendaCommand}"
                                             CommandParameter="{Binding .}"/>
                                </HorizontalStackLayout>
                            </Grid>
                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={RelativeSource AncestorType={x:Type ContentPage}},
                                Path=BindingContext.EditarVendaCommand}"
                                CommandParameter="{Binding .}"/>
                            </Border.GestureRecognizers>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <Label Text="Nenhuma venda realizada hoje."
                           TextColor="#E0E0E0"
                           FontAttributes="Bold"
                           HorizontalOptions="Center"
                           Margin="0,30"/>
                </CollectionView.EmptyView>
            </CollectionView>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>